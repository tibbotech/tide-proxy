{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": ["ES2020"],
        "strict": true,
        "outDir": "./lib",
        "rootDir": "./src",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": ["src/**/*"]
}
